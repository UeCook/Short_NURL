#!/usr/bin/env php
<?php
/**
 * nurl-key — Short_NURL 远程短链管理工具 v2.1
 *
 * 通过无头 API（headless）远程管理短链，需要网络连接。
 * 认证方式：X-Headless-Token 请求头
 *
 * 用法：php nurl-key -key "su_xxx" <操作> [参数]
 *
 * 操作：
 *   -list                    查看所有短链
 *   -stat                    查看配额状态
 *   -get "code"              查看单条短链
 *   -add -url "https://..." -ttl 0 [-code "abc"]
 *                            创建短链（-code 可选，不填自动生成）
 *   -rm -code "abc"          删除短链
 *   -h / -help               显示帮助信息
 *   -v                       查看版本
 */

// ── 初始化 ───────────────────────────────────────────────
if (PHP_SAPI !== 'cli') {
    fwrite(STDERR, "错误：此脚本必须从命令行运行。\n");
    exit(1);
}

define('NURL_KEY_VERSION', '2.1');

$configPath = __DIR__ . '/api/config.php';
if (!file_exists($configPath)) {
    fwrite(STDERR, "错误：在 $configPath 未找到 config.php\n");
    exit(1);
}
$cfg = require $configPath;
$domain = $cfg['domain'];

// ── 解析参数 ─────────────────────────────────────────────
$args = array_slice($argv, 1);

if (empty($args)) {
    showHelp();
    exit(0);
}

$hasH    = in_array('-h', $args) || in_array('-help', $args);
$hasV    = in_array('-v', $args);
$hasList = in_array('-list', $args);
$hasStat = in_array('-stat', $args);
$hasGet  = in_array('-get', $args);
$hasAdd  = in_array('-add', $args);
$hasRm   = in_array('-rm', $args);
$insecureMode = in_array('-insecure', $args);

// 提取 -key 值
$key = extractValue($args, '-key');
// 提取 -get 值（位置参数）
$getCode = extractValue($args, '-get');
// 提取 -add 参数
$addUrl  = extractValue($args, '-url');
$addTtl  = extractValue($args, '-ttl');
$addCode = extractValue($args, '-code');
// 提取 -rm 参数
$rmCode  = extractValue($args, '-code');

// ── 路由命令 ─────────────────────────────────────────────

if ($hasH) {
    showHelp();
    exit(0);
}

if ($hasV) {
    echo "nurl-key v" . NURL_KEY_VERSION . "\n";
    exit(0);
}

// 所有操作都需要 Key
if (!$key) {
    fwrite(STDERR, "错误：缺少密钥。请使用 -key \"su_xxx\" 指定 API Key。\n");
    exit(1);
}

if ($hasList) {
    doList($domain, $key, $insecureMode);
} elseif ($hasStat) {
    doStat($domain, $key, $insecureMode);
} elseif ($hasGet && $getCode) {
    doGet($domain, $key, $getCode, $insecureMode);
} elseif ($hasAdd) {
    doAdd($domain, $key, $addUrl, $addTtl, $addCode, $insecureMode);
} elseif ($hasRm && $rmCode) {
    doRm($domain, $key, $rmCode, $insecureMode);
} else {
    fwrite(STDERR, "错误：未指定有效操作。\n");
    fwrite(STDERR, "运行 'php nurl-key -h' 查看用法。\n");
    exit(1);
}

// ═══════════════════════════════════════════════════════════
// ── 参数解析辅助 ──────────────────────────────────────────
// ═══════════════════════════════════════════════════════════

/**
 * 从参数数组中提取标志对应的值
 * 支持两种格式：
 *   -flag "value"  （空格分隔，下一个参数）
 *   -flag:"value"  （冒号分隔，同一参数内）
 */
function extractValue(array $args, string $flag): ?string
{
    static $knownFlags = [
        '-key', '-get', '-url', '-ttl', '-code',
        '-add', '-rm', '-list', '-stat', '-h', '-help', '-v', '-insecure',
    ];
    $colonPrefix = $flag . ':';
    foreach ($args as $i => $arg) {
        if (strpos($arg, $colonPrefix) === 0) {
            return substr($arg, strlen($colonPrefix));
        }
        if ($arg === $flag && isset($args[$i + 1])) {
            $next = $args[$i + 1];
            if (!in_array($next, $knownFlags, true)) {
                return $next;
            }
        }
    }
    return null;
}

// ═══════════════════════════════════════════════════════════
// ── HTTP 请求辅助 ─────────────────────────────────────────
// ═══════════════════════════════════════════════════════════

function headlessGet(string $domain, string $key, string $path, bool $insecure = false): array
{
    $url = $domain . '/headless/api' . $path;
    $ch = curl_init();
    if ($ch === false) {
        fwrite(STDERR, "错误：cURL 初始化失败\n");
        exit(1);
    }
    curl_setopt_array($ch, [
        CURLOPT_URL => $url,
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_TIMEOUT => 10,
        CURLOPT_SSL_VERIFYPEER => !$insecure,
        CURLOPT_SSL_VERIFYHOST => $insecure ? 0 : 2,
        CURLOPT_HTTPHEADER => [
            'X-Headless-Token: ' . $key,
        ],
    ]);
    $body = curl_exec($ch);
    $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $error = curl_error($ch);
    curl_close($ch);

    if ($error) {
        fwrite(STDERR, "网络错误：$error\n");
        exit(1);
    }

    $data = json_decode($body, true);
    return ['code' => $httpCode, 'body' => $data, 'raw' => $body];
}

function headlessPost(string $domain, string $key, string $path, array $payload, bool $insecure = false): array
{
    $url = $domain . '/headless/api' . $path;
    $json = json_encode($payload, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
    $ch = curl_init();
    if ($ch === false) {
        fwrite(STDERR, "错误：cURL 初始化失败\n");
        exit(1);
    }
    curl_setopt_array($ch, [
        CURLOPT_URL => $url,
        CURLOPT_POST => true,
        CURLOPT_POSTFIELDS => $json,
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_TIMEOUT => 10,
        CURLOPT_SSL_VERIFYPEER => !$insecure,
        CURLOPT_SSL_VERIFYHOST => $insecure ? 0 : 2,
        CURLOPT_HTTPHEADER => [
            'Content-Type: application/json',
            'X-Headless-Token: ' . $key,
        ],
    ]);
    $body = curl_exec($ch);
    $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $error = curl_error($ch);
    curl_close($ch);

    if ($error) {
        fwrite(STDERR, "网络错误：$error\n");
        exit(1);
    }

    $data = json_decode($body, true);
    return ['code' => $httpCode, 'body' => $data, 'raw' => $body];
}

function handleErrorResponse(array $resp): void
{
    $httpCode = $resp['code'];
    $body = $resp['body'];

    if ($httpCode >= 400) {
        if ($body && isset($body['error'])) {
            $msg = $body['message'] ?? '(无详细信息)';
            fwrite(STDERR, "错误 ({$body['error']}): {$msg} [HTTP $httpCode]\n");
        } else {
            fwrite(STDERR, "错误：HTTP $httpCode\n");
            if ($resp['raw']) fwrite(STDERR, "响应：{$resp['raw']}\n");
        }
        exit(1);
    }

    if (!is_array($body)) {
        fwrite(STDERR, "错误：服务端返回非预期格式 [HTTP $httpCode]\n");
        if ($resp['raw']) fwrite(STDERR, "响应：{$resp['raw']}\n");
        exit(1);
    }
}

// ═══════════════════════════════════════════════════════════
// ── 命令实现 ──────────────────────────────────────────────
// ═══════════════════════════════════════════════════════════

function doList(string $domain, string $key, bool $insecure = false): void
{
    // @外调用_&24：headlessGet — nurl-key -list 查询短链列表
    $resp = headlessGet($domain, $key, '/list', $insecure);
    handleErrorResponse($resp);

    $data = $resp['body'];
    $permanent = $data['permanent'] ?? [];
    $temporary = $data['temporary'] ?? [];

    echo "短链列表\n";
    echo str_repeat('─', 60) . "\n\n";

    echo "永久短链（" . count($permanent) . " 条）：\n";
    if (empty($permanent)) {
        echo "  （空）\n";
    } else {
        foreach ($permanent as $i => $p) {
            echo "  " . ($i + 1) . ". {$p['id']}  →  {$p['url']}\n";
            echo "     {$p['lurl']}\n";
        }
    }
    echo "\n";

    echo "临时短链（" . count($temporary) . " 条）：\n";
    if (empty($temporary)) {
        echo "  （空）\n";
    } else {
        foreach ($temporary as $i => $t) {
            echo "  " . ($i + 1) . ". {$t['id']}  →  {$t['url']}\n";
            echo "     {$t['lurl']}\n";
            // exp 为 ISO 8601 字符串；null 防御（理论上有效临时短链不会为 null）
            $expStr = $t['exp'] ?? '';
            echo "     过期：" . ($expStr !== '' ? $expStr : '未知') . "\n";
        }
    }
    echo "\n";
}

function doStat(string $domain, string $key, bool $insecure = false): void
{
    // @外调用_&25：headlessGet — nurl-key -stat 查询配额状态
    $resp = headlessGet($domain, $key, '/stat', $insecure);
    handleErrorResponse($resp);

    $data = $resp['body'];
    echo "配额状态\n";
    echo str_repeat('─', 40) . "\n";
    echo "  永久短链：{$data['perm_count']} / {$data['perm_limit']}\n";
    echo "  临时短链：{$data['temp_count']} / {$data['temp_limit']}\n";
}

function doGet(string $domain, string $key, string $code, bool $insecure = false): void
{
    // @外调用_&26：headlessGet — nurl-key -get 查询单条短链
    $resp = headlessGet($domain, $key, '/get/' . $code, $insecure);
    handleErrorResponse($resp);

    $data = $resp['body'];
    echo "短链详情\n";
    echo str_repeat('─', 40) . "\n";
    echo "  后缀：    {$data['id']}\n";
    echo "  目标：    {$data['url']}\n";
    echo "  短链：    {$data['lurl']}\n";
    // 统一 exp 语义：永久短链为 "permanent"，临时短链为 ISO 8601 字符串
    $expVal = $data['exp'] ?? 'permanent';
    if ($expVal === 'permanent') {
        echo "  类型：    永久\n";
    } elseif ($expVal === null) {
        // null 防御（get.php 中理论上不会出现，但契约允许）
        echo "  类型：    未知\n";
    } else {
        echo "  过期：    {$expVal}\n";
    }
    echo "\n";
}

function doAdd(string $domain, string $key, ?string $url, ?string $ttl, ?string $code, bool $insecure = false): void
{
    if (!$url) {
        fwrite(STDERR, "错误：缺少目标链接。请使用 -url \"https://...\" 指定。\n");
        exit(1);
    }

    $ttlVal = $ttl !== null ? intval($ttl) : 0;
    $payload = [
        'url' => $url,
        'ttl' => $ttlVal,
    ];
    if ($code) {
        $payload['code'] = $code;
    }

    echo "正在创建短链...\n";
    // @外调用_&27：headlessPost — nurl-key -add 创建短链
    $resp = headlessPost($domain, $key, '/create', $payload, $insecure);
    handleErrorResponse($resp);

    $data = $resp['body'];
    // 统一响应结构后，字段始终存在，根据语义选择性输出
    if (isset($data['dedup']) && $data['dedup'] === true) {
        echo "命中去重 ✓（复用已有永久短链，未实际写入）\n";
    } else {
        echo "创建成功 ✓\n";
    }
    echo "  短链：{$data['short_url']}\n";
    // exp 统一为 null（永久）或 ISO 8601 字符串（临时）
    if (isset($data['exp']) && $data['exp'] !== null) {
        echo "  过期：{$data['exp']}\n";
    }
    // synced=false 表示热存储未同步，短链在缓存窗口内可能不可用
    if (isset($data['synced']) && $data['synced'] === false) {
        $warn = $data['warning'] ?? '热存储同步失败，短链暂不可用';
        fwrite(STDERR, "  警告：{$warn}\n");
    }
    // key_consumed=true 表示消费了一次性 Key
    if (isset($data['key_consumed']) && $data['key_consumed'] === true) {
        echo "  注：本次请求已消费一次性 Key，该 Key 不可再次使用\n";
    }
    echo "\n";
}

function doRm(string $domain, string $key, string $code, bool $insecure = false): void
{
    echo "正在删除短链 {$code}...\n";
    // @外调用_&28：headlessPost — nurl-key -rm 删除短链
    $resp = headlessPost($domain, $key, '/delete', ['code' => $code], $insecure);
    handleErrorResponse($resp);

    $data = $resp['body'];
    echo "删除成功 ✓\n";
    echo "  已删除：{$code}\n";
    // synced=false 表示热存储未同步，缓存窗口内短链仍可能跳转
    if (isset($data['synced']) && $data['synced'] === false) {
        fwrite(STDERR, "  警告：缓存可能有延迟，短链在短期内仍可能可访问\n");
    }
    echo "\n";
}

function showHelp(): void
{
    echo "nurl-key — Short_NURL 远程短链管理工具 v" . NURL_KEY_VERSION . "\n\n";
    echo "用法：php nurl-key -key \"su_xxx\" <操作> [参数]\n\n";
    echo "操作：\n";
    echo "  -list                          查看所有短链\n";
    echo "  -stat                          查看配额状态\n";
    echo "  -get \"code\"                    查看单条短链\n";
    echo "  -add -url \"https://...\" \\      创建短链\n";
    echo "       -ttl 0 [-code \"abc\"]\n";
    echo "  -rm -code \"abc\"                删除短链\n\n";
    echo "参数：\n";
    echo "  -key \"su_xxx\"    API Key（必填）\n";
    echo "  -url \"https://..\" 目标长链接（-add 必填）\n";
    echo "  -ttl N           有效期秒数，0=永久（默认 0）\n";
    echo "  -code \"abc\"      短链后缀，1-4 位（可选）\n\n";
    echo "标志支持两种赋值格式：\n";
    echo "  -key \"su_xxx\"    空格分隔\n";
    echo "  -key:\"su_xxx\"    冒号分隔\n\n";
    echo "TTL 常用值：\n";
    echo "  0         永久\n";
    echo "  1800      30 分钟\n";
    echo "  3600      1 小时\n";
    echo "  86400     1 天\n";
    echo "  604800    7 天\n\n";
    echo "其他：\n";
    echo "  -v            查看版本\n";
    echo "  -insecure     跳过 SSL 证书验证（仅用于内网/自签名证书）\n";
    echo "  -h / -help    显示此帮助信息\n\n";
    echo "支持的密钥类型：常驻密钥、一次性密钥、服务密钥\n";
    echo "  服务密钥仅限无头模式使用，前端 API 将拒绝服务密钥。\n\n";
    echo "本地密钥管理请使用：php nurl\n";
}
